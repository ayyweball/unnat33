# ==============================================================================
# SIH26091 - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and set real values for your environment.
# NEVER commit sensitive credentials or real production API keys.
# ==============================================================================

# Core API Configuration (Points to Authoritative FastAPI Backend)
# In production on Vercel, set BACKEND_URL to your deployed FastAPI backend URL.
# Client requests to /api/v1/:path* automatically rewrite to BACKEND_URL with zero CORS issues.
BACKEND_URL=https://your-fastapi-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=

# Application Configuration
NEXT_PUBLIC_APP_NAME=Unnate SIH26091
NEXT_PUBLIC_APP_URL=https://unnate.vercel.app
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_THEME=light

# Features & Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_FEATURE_CHAT=true
NEXT_PUBLIC_FEATURE_DPR_PDF=true

# Localization / i18n
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,hi

# Pagination & Session Timeouts
NEXT_PUBLIC_ITEMS_PER_PAGE=10
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=1440

# JWT & Prisma Database URL (Client Profile & Advisory Session Store)
# With Neon PostgreSQL, specify ?schema=unnate_app to isolate client session tables from public scheme tables
JWT_SECRET=your-secure-jwt-secret-for-production
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?schema=unnate_app&sslmode=require

# Primary AI Engine: Groq AI (Ultra-fast, high limits: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary AI Engine: Anthropic Claude (Server-Side Next.js Route Handlers)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
